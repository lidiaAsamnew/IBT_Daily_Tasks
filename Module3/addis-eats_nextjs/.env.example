# Copy to .env.local and fill in. Never commit .env.local.
# Every variable the app reads is listed here (Day 43 / Day 48 pre-flight).

# --- Server only -------------------------------------------------------------
# Signs the session cookie. At least 32 characters; use a DIFFERENT value per
# environment (development / preview / production).  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-32chars-min

# Hosted Postgres (Neon, via the Vercel Marketplace). Leave EMPTY in development to
# use a local JSON file at .data/db.json instead.
DATABASE_URL=

# Optional staff account for /kitchen and /dashboard. Created on first sign-in
# with these credentials. Leave both empty to have no staff account.
STAFF_PHONE=0911000000
STAFF_NAME=Kitchen Staff
STAFF_PASSWORD=change-this-staff-password

# --- Public (inlined into the browser bundle at BUILD time — never put a secret here)
# Your live origin, no trailing slash. If empty on Vercel, the VERCEL_* system
# variables are used instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
