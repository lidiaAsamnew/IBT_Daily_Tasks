# Copy to .env.local (never commit .env.local - it is gitignored by `.env*.local`). Dummy values only.
#
# Server-only: NO NEXT_PUBLIC_ prefix. These never reach the browser.
SESSION_SECRET=replace-with-a-long-random-string

# Day 42: the session cookie is "secure" (HTTPS only). Chrome, Edge and Firefox accept it on
# http://localhost. If sign-in does nothing in Safari or on a LAN address, uncomment this (dev only):
# INSECURE_DEV_COOKIES=1

# Public: NEXT_PUBLIC_ means "inlined into the browser bundle at build time". Readable by anyone,
# and changing it needs a new build, not a restart. NEVER put a secret here.
# Day 43 (optional): URL of an analytics script, loaded lazily with next/script. Leave empty to load nothing.
# NEXT_PUBLIC_ANALYTICS_SRC=https://analytics.example/s.js

# Day 44: the PRODUCTION address of the site. Used for metadataBase, canonical URLs, og:image, JSON-LD
# and the sitemap. Public (it is in every page's HTML), inlined at build time, so a change needs a rebuild.
# Default if unset: https://addiseats.et. For local testing of share cards: http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://addiseats.et
